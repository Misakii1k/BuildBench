{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本地构建台", "version": "0.1.0", "identifier": "com.local.buildbench",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "本地构建台", "width": 1360, "height": 850, "minWidth": 980, "minHeight": 680, "resizable": true }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": "nsis", "icon": ["icons/icon.ico"], "windows": { "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "languages": ["SimpChinese", "English"] } } }
}
